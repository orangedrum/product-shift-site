{
  "manifest_version": 3,
  "name": "Product Shift: AI UX Auditor",
  "version": "1.0",
  "description": "Instant AI-powered UX audit for any website you visit.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "permissions": [
    "sidePanel",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}