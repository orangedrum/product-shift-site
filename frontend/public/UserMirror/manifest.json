{
  "manifest_version": 3,
  "name": "User Mirror by The ProductShift",
  "version": "1.0",
  "description": "Instant SEO Audit, Client Pitch Tool, and Web Design Feedback. Analyze any webpage instantly with AI.",
  "permissions": [
    "sidePanel",
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "side_panel": {
    "default_path": "index.html"
  "action": {
    "default_title": "Open User Mirror"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
